# Base URL of the GRAND-ERP API (no trailing slash). Defaults to the contract's
# own dev server, http://127.0.0.1:3000, when unset.
#
# Expo inlines EXPO_PUBLIC_* at build time, so changing this needs a dev-server
# restart. Plain http:// is only accepted in dev builds — a release build
# pointed at one throws on startup rather than sending passwords in the clear.
#
# Note that 127.0.0.1 is the *device's* loopback: on an Android emulator use
# http://10.0.2.2:3000, and on a physical device use the LAN IP of the machine
# running the API.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000
